+bool ApfsVolume::CryptBlocks(uint8_t *data, uint64_t blkcnt, uint64_t xts_tweak, bool encrypt)
+{
+	constexpr int encryption_block_size = 0x200;
+
+	if (!m_is_encrypted)
+		return true;
+
+	uint64_t cs_factor = m_container.GetBlocksize() / encryption_block_size;
+	uint64_t uno = xts_tweak * cs_factor;
+	size_t size = blkcnt * m_container.GetBlocksize();
+
+	for (size_t k = 0; k < size; k += encryption_block_size)
+	{
+		if (encrypt)
+			m_aes.Encrypt(data + k, data + k, encryption_block_size, uno);
+		else
+			m_aes.Decrypt(data + k, data + k, encryption_block_size, uno);
+		uno++;
+	}
+	return true;
+}
