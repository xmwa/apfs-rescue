 #include "ApfsNodeMapperBTree.h"
 #include "ApfsContainer.h"
 
+static std::multimap<oid_t, omap_res_t> g_omap_fallback;
+
+// File format, one mapping per line, hex: oid xid paddr flags size [ignored...]
+size_t OmapFallbackLoad(const char *path)
+{
+	FILE *f = fopen(path, "r");
+	char line[256];
+
+	if (!f)
+		return 0;
+
+	while (fgets(line, sizeof(line), f))
+	{
+		omap_res_t r;
+		uint64_t oid, xid, paddr;
+		unsigned flags, size;
+
+		if (sscanf(line, "%" SCNx64 " %" SCNx64 " %" SCNx64 " %x %x", &oid, &xid, &paddr, &flags, &size) != 5)
+			continue;
+		if (flags & OMAP_VAL_DELETED)
+			continue;
+		r.oid = oid;
+		r.xid = xid;
+		r.paddr = paddr;
+		r.flags = flags;
+		r.size = size;
+		g_omap_fallback.insert(std::make_pair(r.oid, r));
+	}
+	fclose(f);
+
+	return g_omap_fallback.size();
+}
+
+bool OmapFallbackActive()
+{
+	return !g_omap_fallback.empty();
+}
+
+// All salvaged mappings for oid that are not newer than xid, newest first.
+void OmapFallbackCandidates(std::vector<omap_res_t> &out, oid_t oid, xid_t xid)
+{
+	auto range = g_omap_fallback.equal_range(oid);
+
+	for (auto it = range.first; it != range.second; ++it)
+	{
+		const omap_res_t &r = it->second;
+		bool dup = false;
+
+		if (r.xid > xid)
+			continue;
+		for (const omap_res_t &o : out)
+			if (o.paddr == r.paddr && o.xid == r.xid)
+				dup = true;
+		if (!dup)
+			out.push_back(r);
+	}
+
+	std::sort(out.begin(), out.end(), [](const omap_res_t &a, const omap_res_t &b) { return a.xid > b.xid; });
+}
