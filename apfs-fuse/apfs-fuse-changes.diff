+// Recovery check for a candidate child block of a file-system tree node:
+// one level below the parent, and its first key inside the parent's range
+// for that child (compared by object id and record type).
+static bool FitsUnderParent(const uint8_t *blk, const std::shared_ptr<BTreeNode> &parent, uint32_t parent_index)
+{
+	const btree_node_phys_t *btn = reinterpret_cast<const btree_node_phys_t *>(blk);
+
+	if (btn->btn_o.o_subtype != OBJECT_TYPE_FSTREE)
+		return true;
+	if (btn->btn_level + 1 != parent->level())
+		return false;
+	if (btn->btn_nkeys == 0 || (btn->btn_flags & BTNODE_FIXED_KV_SIZE))
+		return true;
+
+	BTreeEntry pe;
+	if (!parent->GetEntry(pe, parent_index) || pe.key_len < sizeof(uint64_t))
+		return true;
+
+	// first key of the candidate (variable-size key/value node layout)
+	const size_t toc = sizeof(btree_node_phys_t) + btn->btn_table_space.off;
+	const size_t keys = toc + btn->btn_table_space.len;
+	const kvloc_t *loc = reinterpret_cast<const kvloc_t *>(blk + toc);
+	if (keys + loc->k.off + sizeof(uint64_t) > 4096)
+		return false;
+
+	auto split = [](uint64_t v, uint64_t &id, uint64_t &type) { id = v & OBJ_ID_MASK; type = v >> OBJ_TYPE_SHIFT; };
+	uint64_t cid, ctype, pid, ptype;
+	uint64_t cv, pv;
+	memcpy(&cv, blk + keys + loc->k.off, sizeof(cv));
+	memcpy(&pv, pe.key, sizeof(pv));
+	split(cv, cid, ctype);
+	split(pv, pid, ptype);
+
+	if (cid < pid || (cid == pid && ctype < ptype))
+		return false;
+
+	if (parent_index + 1 < parent->entries_cnt())
+	{
+		BTreeEntry ne;
+		if (parent->GetEntry(ne, parent_index + 1) && ne.key_len >= sizeof(uint64_t))
+		{
+			uint64_t nv, nid, ntype;
+			memcpy(&nv, ne.key, sizeof(nv));
+			split(nv, nid, ntype);
+			if (cid > nid || (cid == nid && ctype > ntype))
+				return false;
+		}
+	}
+
+	return true;
+}
