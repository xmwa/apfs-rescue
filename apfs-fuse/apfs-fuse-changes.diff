@@ -102,6 +104,30 @@ bool DeviceMac::Read(void* data, uint64_t offs, uint64_t len)
 
 	nread = pread(m_device, data, len, offs);
 
+	// Working on a sparse local copy that holds only part of a disk: a read
+	// that lands in a hole returns zeros. With APFS_HOLE_LOG set, every such
+	// read is logged as "byte_offset length" so the missing blocks can be
+	// fetched from the real disk.
+	static const char *hole_log = getenv("APFS_HOLE_LOG");
+	if (hole_log && nread == len)
+	{
+		off_t d = lseek(m_device, (off_t)offs, SEEK_DATA);
+		if (d == -1 || (uint64_t)d >= offs + len || (uint64_t)d > offs)
+		{
+			FILE *f = fopen(hole_log, "a");
+			if (f) { fprintf(f, "%llu %llu\n", (unsigned long long)offs, (unsigned long long)len); fclose(f); }
+		}
+		else
+		{
+			off_t h = lseek(m_device, (off_t)offs, SEEK_HOLE);
+			if (h != -1 && (uint64_t)h < offs + len)
+			{
+				FILE *f = fopen(hole_log, "a");
+				if (f) { fprintf(f, "%llu %llu\n", (unsigned long long)offs, (unsigned long long)len); fclose(f); }
+			}
+		}
+	}
+
 	// TODO: Better error handling ...
 	return nread == len;
 }
